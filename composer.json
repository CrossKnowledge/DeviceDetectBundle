{
  "name": "crossknowledge/devicedetect-bundle",
  "description": "matomo/device-detector wrapped for Symfony2",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "Device detect",
    "matomo device-detector",
    "bundle",
    "Symfony",
    "Symfony2"
  ],
  "authors": [
    {
      "name": "CrossKnowledge"
    }
  ],
  "autoload": {
    "psr-4": { "CrossKnowledge\\DeviceDetectBundle\\": "" }
  },
  "require": {
    "php": ">=7.2",
    "matomo/device-detector": "^6.3.2",
    "symfony/flex": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8",
    "roave/security-advisories": "dev-master",
    "symfony/phpunit-bridge": "^6"
  },
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "require": "4.4.* || 5.0.* || 6.0.*"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true
    }
  }
}
